# Configure these variables in Railway. Do not commit real credentials.
APP_ENV=production
DEMO_MODE=false
COOKIE_SECURE=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PUBLIC_URL=https://YOUR-DOMAIN
ALLOWED_ORIGINS=https://YOUR-DOMAIN
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional context connectors / WhatsApp OTP
INTEGRATION_ALLOWED_HOSTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
