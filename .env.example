# === PostgreSQL ===
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/sup_better_engine
DATABASE_URL_SYNC=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sup_better_engine

# === Backend ===
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
CORS_ORIGINS=["http://localhost:3000"]

# === LLM ===
CLASSIFIER_MODE=stub
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# === Operational Parameters (provisórios — revisão semana 2) ===
SESSION_TTL_HOURS=24
RATE_LIMIT_PER_IP_PER_HOUR=30
TURN_LIMIT_PER_SESSION=40
EMAIL_MODAL_TRIGGER_TURN=4
EMAIL_MODAL_MAX_DISPLAYS=2

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
