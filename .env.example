# Copy to .env. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Local: SQLite is persisted under data/. Railway: use a PostgreSQL reference.
DATABASE_URL=sqlite:///data/elo.db
PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Only for fictional hackathon/demo workspaces. Set false for real tenants.
DEMO_MODE=true
# Transactional activation links: STARTTLS SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Explicitly trusted domains for read-only context imports; no redirects.
INTEGRATION_ALLOWED_HOSTS=
# CONNECTOR_MY_CRM_TOKEN=
# Optional WhatsApp verification, Twilio Verify service with WhatsApp enabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
